{
  "name": "multi-agent-support-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "dotenv -e .env.local -- tsx scripts/seed-db.ts",
    "ingest": "dotenv -e .env.local -- tsx scripts/ingest-docs.ts",
    "reset": "dotenv -e .env.local -- tsx scripts/reset-demo.ts",
    "knowledge:fetch": "tsx scripts/knowledge-fetch-docs.ts",
    "knowledge:refresh": "tsx scripts/knowledge-fetch-docs.ts --force",
    "knowledge:ingest": "dotenv -e .env.local -- tsx scripts/knowledge-ingest.ts",
    "knowledge:seed": "npm run knowledge:fetch && npm run knowledge:ingest",
    "knowledge:reset": "dotenv -e .env.local -- tsx scripts/knowledge-reset.ts && npm run knowledge:ingest",
    "knowledge:evaluate": "dotenv -e .env.local -- tsx scripts/knowledge-evaluate.ts",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.12.12",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^6.3.1",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inngest": "^3.29.13",
    "lucide-react": "^0.475.0",
    "next": "^15.5.18",
    "openai": "^4.85.4",
    "prisma": "^6.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.32",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
