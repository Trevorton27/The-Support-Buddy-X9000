generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  company      String
  plan         String   // "free" | "pro" | "enterprise"
  region       String   // "us-east-1" | "eu-west-1" | etc.
  industry     String
  accountAge   Int      // months
  orgId        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets      Ticket[]

  @@index([orgId])
}

model Ticket {
  id            String   @id @default(cuid())
  externalId    String?  @unique // for GitHub Issues integration
  title         String
  description   String
  status        String   @default("open")   // "open" | "in_progress" | "resolved" | "archived"
  severity      String   @default("medium") // "critical" | "high" | "medium" | "low"
  category      String?
  product       String?
  customerId    String
  orgId         String   @default("")
  duplicateOfId String?                     // set when HF dedup detects a near-duplicate
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assigneeId    String?
  githubIssueUrl    String?
  githubIssueNumber Int?

  customer       Customer          @relation(fields: [customerId], references: [id])
  investigations InvestigationRun[]
  incidents      IncidentTicket[]
  duplicateOf    Ticket?           @relation("TicketDuplicates", fields: [duplicateOfId], references: [id])
  duplicates     Ticket[]          @relation("TicketDuplicates")
  retrievalResults RetrievalResult[]
  generatedMeta  GeneratedTicketMeta?
  messages       TicketMessage[]
  workItems      WorkItem[]
  devinTasks     DevinTask[]

  @@index([orgId])
}

model InvestigationRun {
  id             String    @id @default(cuid())
  ticketId       String
  status         String    @default("pending") // "pending" | "running" | "awaiting_approval" | "complete" | "failed"
  hypotheses     Json?
  summary        String?   // drafted customer reply
  escalationNote String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?
  orgId          String    @default("")

  // Phase 2: Guardrails
  guardrailsPassed Boolean @default(true)
  guardrailsResult Json?

  // Phase 3: HITL Approval
  approvalStatus String?   // "pending" | "approved" | "rejected" | "timeout"
  approvedAt     DateTime?
  approvedBy     String?   // Clerk userId
  editedReply    String?   // human-edited version of summary
  reviewerNote   String?

  ticket           Ticket          @relation(fields: [ticketId], references: [id])
  steps            AgentStep[]
  approvalRequests ApprovalAudit[]
  retrievalResults RetrievalResult[]
  workItems        WorkItem[]
  devinTasks       DevinTask[]

  @@index([orgId])
}

model AgentStep {
  id                 String    @id @default(cuid())
  investigationRunId String
  agentName          String
  status             String    @default("pending") // "pending" | "running" | "complete" | "failed"
  input              Json?
  output             Json?
  errorMessage       String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  durationMs         Int?

  // Phase 1: Agent Control Center telemetry
  tokenUsage      Json?  // { promptTokens, completionTokens, totalTokens }
  toolsCalled     Json?  // string[]
  confidenceScore Float? // 0.0–1.0

  investigationRun InvestigationRun @relation(fields: [investigationRunId], references: [id])
}

model KnowledgeChunk {
  id          String                       @id @default(cuid())
  documentId  String?                      // FK to KnowledgeDocument; null for legacy chunks
  sourcePath  String
  chunkIndex  Int
  content     String
  embedding   Unsupported("vector(1536)")?
  tokenCount  Int?
  metadata    Json?                        // { heading?, sourceType?, tags?, productArea? }
  createdAt   DateTime                     @default(now())

  document KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([sourcePath, chunkIndex])
  @@index([documentId])
}

// Phase 3: HITL Approval Audit Trail
model ApprovalAudit {
  id                 String   @id @default(cuid())
  investigationRunId String
  action             String   // "approved" | "rejected" | "edited"
  actorId            String   // Clerk userId
  originalDraft      String
  finalDraft         String?
  note               String?
  createdAt          DateTime @default(now())

  investigationRun InvestigationRun @relation(fields: [investigationRunId], references: [id])
}

// Phase 5: Integration Config
model IntegrationConfig {
  id         String    @id @default(cuid())
  type       String    // "sentry" | "datadog" | "slack" | "zendesk" | "jira" | "github"
  enabled    Boolean   @default(false)
  config     Json      // non-secret metadata (project IDs, labels, etc.)
  lastSyncAt DateTime?
  orgId      String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId])
}

// Phase 6: Incident Management
model Incident {
  id                  String    @id @default(cuid())
  title               String
  status              String    @default("investigating") // "investigating" | "identified" | "monitoring" | "resolved"
  severity            String    // "P0" | "P1" | "P2"
  affectedProduct     String
  affectedRegion      String
  rootCauseHypothesis String?
  statusPageMessage   String?
  internalTimeline    Json?     // { timestamp, event, author }[]
  orgId               String    @default("")
  startedAt           DateTime  @default(now())
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tickets   IncidentTicket[]
  workItems WorkItem[]

  @@index([orgId])
}

model IncidentTicket {
  id         String   @id @default(cuid())
  incidentId String
  ticketId   String
  addedAt    DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
  ticket   Ticket   @relation(fields: [ticketId], references: [id])

  @@unique([incidentId, ticketId])
}

// Phase 4 + Phase 7: Eval
model EvalExample {
  id                       String   @id @default(cuid())
  sourceRunId              String?
  ticketTitle              String
  ticketDescription        String
  expectedRootCause        String
  expectedSeverity         String
  expectedEvidenceKeywords Json     // string[]
  approvedReply            String
  evidenceChunks           Json     // top chunks + rerank scores
  orgId                    String   @default("")
  createdAt                DateTime @default(now())

  evalResults EvalResult[]

  @@index([orgId])
}

model EvalRun {
  id          String    @id @default(cuid())
  name        String
  triggeredBy String
  status      String    @default("running") // "running" | "complete" | "failed"
  model       String    @default("gpt-4o")  // model used for reasoning nodes
  passRate    Float?
  avgScore    Float?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  results EvalResult[]
}

model EvalResult {
  id                 String   @id @default(cuid())
  evalRunId          String
  evalExampleId      String
  investigationRunId String?
  rootCauseScore     Float?
  evidenceScore      Float?
  toneScore          Float?
  hallucinationScore Float?
  overallScore       Float?
  judgeOutput        Json?
  passed             Boolean
  createdAt          DateTime @default(now())

  evalRun     EvalRun     @relation(fields: [evalRunId], references: [id])
  evalExample EvalExample @relation(fields: [evalExampleId], references: [id])
}

// Ticket Generation System
model GenerationBatch {
  id             String    @id @default(cuid())
  name           String
  status         String    @default("pending")  // "pending"|"running"|"complete"|"failed"
  mode           String                          // "wizard"|"autonomous"|"incident"
  params         Json                            // GenerationParams (full input config)
  totalRequested Int
  totalCreated   Int       @default(0)
  orgId          String    @default("")
  createdBy      String                          // Clerk userId
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  errorMessage   String?

  metas GeneratedTicketMeta[]

  @@index([orgId])
  @@index([status])
}

model GeneratedTicketMeta {
  id              String    @id @default(cuid())
  ticketId        String    @unique
  batchId         String
  trueRootCause   String                         // hidden ground truth
  trueCategory    String
  trueSeverity    String
  affectedProduct String
  injectedFaults  Json      @default("[]")       // string[]
  scenario        String?                         // incident scenario name
  scenarioRole    String?                         // "trigger"|"symptom"|"related"
  difficulty      String    @default("medium")    // "easy"|"medium"|"hard"
  scoreCache      Json?                           // TrainingScores
  scoredAt        DateTime?
  createdAt       DateTime  @default(now())

  ticket Ticket          @relation(fields: [ticketId], references: [id])
  batch  GenerationBatch @relation(fields: [batchId], references: [id])
}

// RAG Knowledge Base — KnowledgeDocument
// sourceType values: RUNBOOK | SUPPORT_TICKET | INCIDENT_REPORT | PRODUCT_DOC | ARCHITECTURE_DOC | ALERT | LOG_SUMMARY | EXTERNAL_DOC
model KnowledgeDocument {
  id              String   @id @default(cuid())
  title           String
  sourceType      String   // RUNBOOK | SUPPORT_TICKET | INCIDENT_REPORT | PRODUCT_DOC | ARCHITECTURE_DOC | ALERT | LOG_SUMMARY | EXTERNAL_DOC
  sourceName      String   // e.g. "clerk", "kubernetes", or original filename
  sourceUrl       String?  // canonical URL for external docs
  productArea     String?  // "Authentication" | "Database" | "Infrastructure" | "Deployment" | etc.
  customerSegment String?  // "enterprise" | "pro" | "all"
  severity        String?  // "critical" | "high" | "medium" | "low"
  tags            Json     // string[]
  content         String   // full original text
  summary         String?  // LLM-generated summary
  filePath        String   @unique // absolute-relative path; used for idempotent re-ingestion
  orgId           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([sourceType])
  @@index([orgId])
}

// RAG Knowledge Base — RetrievalResult audit trail
model RetrievalResult {
  id                 String   @id @default(cuid())
  ticketId           String?
  investigationRunId String?
  query              String
  matchedChunkIds    Json     // string[]
  scoreMetadata      Json     // { chunkId: string, score: number, rerankScore?: number }[]
  createdAt          DateTime @default(now())

  ticket           Ticket?           @relation(fields: [ticketId], references: [id])
  investigationRun InvestigationRun? @relation(fields: [investigationRunId], references: [id])
}

// Mission Control: Work Items — canonical unit of responsibility
model WorkItem {
  id                 String    @id @default(cuid())
  orgId              String
  assigneeId         String?
  type               String    // CUSTOMER_REPLY | INTERNAL_FOLLOW_UP | INVESTIGATION | ESCALATION | APPROVAL | INCIDENT_UPDATE | SCHEDULED_CHECK | DOCUMENTATION | MANUAL_TASK | DEVIN_TASK
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | WAITING_CUSTOMER | WAITING_INTERNAL | SNOOZED | COMPLETED | CANCELLED | NEEDS_CLASSIFICATION
  title              String
  summary            String?
  requiredAction     String?
  reason             String?
  priorityScore      Float     @default(50) // 0-100
  priorityBand       String    @default("MEDIUM") // URGENT | HIGH | MEDIUM | LOW
  dueAt              DateTime?
  snoozedUntil       DateTime?
  waitingOn          String?
  confidence         Float?    // 0-1
  sourceType         String?
  sourceId           String?
  ticketId           String?
  investigationRunId String?
  incidentId         String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ticket           Ticket?           @relation(fields: [ticketId], references: [id])
  investigationRun InvestigationRun? @relation(fields: [investigationRunId], references: [id])
  incident         Incident?         @relation(fields: [incidentId], references: [id])
  events           WorkItemEvent[]
  signals          WorkSignal[]
  devinTask        DevinTask?

  @@index([orgId])
  @@index([assigneeId])
  @@index([status])
  @@index([priorityScore])
  @@index([snoozedUntil])
  @@index([ticketId])
}

// Mission Control: Work Signals — immutable incoming events
model WorkSignal {
  id               String    @id @default(cuid())
  idempotencyKey   String    @unique
  sourceSystem     String
  sourceEventId    String?
  eventType        String
  payload          Json
  evidence         String?
  processingStatus String    @default("pending") // pending | processing | processed | failed | skipped
  extractionResult Json?
  confidence       Float?
  workItemId       String?
  senderId         String?
  recipientId      String?
  orgId            String
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?

  workItem WorkItem? @relation(fields: [workItemId], references: [id])

  @@index([orgId])
  @@index([processingStatus])
}

// Mission Control: Work Item Events — immutable audit trail
model WorkItemEvent {
  id            String    @id @default(cuid())
  workItemId    String
  eventType     String    // created | assigned | reprioritized | snoozed | resumed | completed | cancelled | delegated | status_changed | waiting_set | waiting_cleared | ai_accepted | ai_rejected | corrected
  actorId       String?
  actorType     String    @default("system") // user | system | ai
  previousValue Json?
  newValue      Json?
  note          String?
  createdAt     DateTime  @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id])

  @@index([workItemId])
}

// Mission Control: Agent Work Context — cached per-agent summary
model AgentWorkContext {
  id              String    @id @default(cuid())
  agentId         String
  orgId           String
  summary         String
  briefing        String?
  activeCounts    Json      // { open, inProgress, waiting, snoozed }
  topPriorities   Json      // WorkItem summaries
  risks           Json?
  recentChanges   Json?
  sourceWorkItemIds Json    // string[]
  modelVersion    String?
  promptVersion   String?
  refreshedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agentId, orgId])
}

// Devin AI: Automated bug reproduction and code fixes
model DevinTask {
  id                 String    @id @default(cuid())
  orgId              String
  devinSessionId     String?   @unique
  sessionUrl         String?
  repository         String
  branch             String?
  mode               String    // "reproduce" | "fix"
  status             String    @default("queued") // queued | creating | working | blocked | waiting | pr_ready | finished | failed | expired | cancelled
  promptSnapshot     Json      // full prompt sent to Devin
  structuredResult   Json?     // parsed result
  pullRequestUrl     String?
  errorMessage       String?
  verdict            String?   // reproduce: REPRODUCED | UNABLE_TO_REPRODUCE | CONFIGURATION_ISSUE | PRODUCT_DEFECT | DOCUMENTATION_DEFECT | ADDITIONAL_INFORMATION_REQUIRED
                               // fix: FIX_SUBMITTED | FIX_FAILED
  verdictReason      String?
  pollCount          Int       @default(0)
  lastPolledAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdBy          String    // Clerk userId

  // Relations
  ticketId           String?
  investigationRunId String?
  workItemId         String?   @unique

  ticket             Ticket?           @relation(fields: [ticketId], references: [id])
  investigationRun   InvestigationRun? @relation(fields: [investigationRunId], references: [id])
  workItem           WorkItem?         @relation(fields: [workItemId], references: [id])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orgId])
  @@index([status])
  @@index([devinSessionId])
  @@index([investigationRunId])
  @@index([workItemId])
}

// Demo Lab: Reusable issue scenarios for Devin testing
model DemoIssueScenario {
  id                 String   @id @default(cuid())
  key                String   @unique // e.g. "auth-cert-region-mismatch"
  title              String
  description        String
  repository         String   // GitHub repo URL
  service            String   // e.g. "auth-service"
  affectedPaths      Json     // string[] — files modified by the defect
  baseBranch         String   @default("main")

  ticketTemplate     Json     // { title, description, severity, category, product }
  evidenceTemplate   Json     // { deployment, logs, traces }
  acceptanceCriteria Json     // string[] — what Devin must achieve
  reproductionSteps  Json     // string[] — how to reproduce the bug

  defectPatch        Json?    // { buggyCode, fixedCode, filePath, testFilePath, testCode }
  brokenCommitSha    String?
  fixedCommitSha     String?

  status             String   @default("available") // available | activating | broken | fixing | fixed | resetting | failed
  activeTicketId     String?
  activeDevinTaskId  String?
  activeBranch       String?
  generation         Int      @default(0)

  severity           String   @default("high")   // critical | high | medium | low
  difficulty         String   @default("medium") // easy | medium | hard
  category           String   @default("configuration") // authentication | data | integration | performance | configuration

  orgId              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  runs DemoRun[]

  @@index([orgId])
  @@index([status])
}

// Demo Lab: Individual demo run — one per activation of a scenario
model DemoRun {
  id                String    @id @default(cuid())
  scenarioId        String
  generation        Int
  status            String    @default("pending") // pending | activating | broken | ticket_open | investigating | awaiting_approval | devin_reproducing | devin_fixing | pr_ready | fixed | resetting | failed | completed
  branch            String?
  brokenCommitSha   String?
  fixedCommitSha    String?
  resetCommitSha    String?
  ticketId          String?
  investigationId   String?
  devinReproduceId  String?
  devinFixId        String?
  pullRequestUrl    String?
  errorMessage      String?
  timeline          Json?     // { timestamp, event, detail }[]
  createdBy         String    // Clerk userId
  orgId             String    @default("")
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  scenario DemoIssueScenario @relation(fields: [scenarioId], references: [id])

  @@index([scenarioId])
  @@index([orgId])
  @@index([status])
}

// Demo Lab: Trusted code repositories
model CodeRepository {
  id              String  @id @default(cuid())
  orgId           String  @default("")
  name            String  // display name
  owner           String  // GitHub owner/org
  repository      String  // "owner/repo"
  defaultBranch   String  @default("main")
  githubInstallId String?
  allowedForDevin Boolean @default(false)

  services ProductService[]

  @@unique([orgId, repository])
  @@index([orgId])
}

// Demo Lab: Service-to-repository mapping
model ProductService {
  id           String  @id @default(cuid())
  name         String  @unique // e.g. "auth-service"
  repositoryId String
  workingDir   String? // e.g. "services/auth-service"
  pathPatterns Json    // string[] — glob patterns for this service
  testCommand  String? // e.g. "npm run test:auth"

  repository CodeRepository @relation(fields: [repositoryId], references: [id])
}

// Mission Control: Ticket Messages — conversation on tickets
model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  content    String
  authorType String   // customer | agent | system | ai
  authorId   String?
  authorName String?
  channel    String   @default("web") // web | email | slack | zendesk | api
  metadata   Json?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
